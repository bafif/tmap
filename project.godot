; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TellMAP"
config/description="Atlas histórico interactivo: fronteras, pueblos y fuentes ordenadas en el espacio y el tiempo."
config/version="0.3.2"
run/main_scene="res://scenes/principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.074, 0.082, 0.094, 1)
run/low_processor_mode=true

[autoload]

Arranque="*res://scripts/nucleo/arranque.gd"
Estado="*res://scripts/nucleo/estado.gd"
Actualizador="*res://scripts/nucleo/actualizador.gd"
DatosMapa="*res://scripts/nucleo/datos_mapa.gd"
Enciclopedia="*res://scripts/nucleo/enciclopedia.gd"
Wiki="*res://scripts/nucleo/wiki.gd"
Puente="*res://addons/tellmap_puente/juego.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="disabled"

[editor_plugins]

enabled=PackedStringArray("res://addons/tellmap_puente/plugin.cfg")

[dotnet]

project/assembly_name="TellMAP"

[input]

